# Convex Backend
CONVEX_DEPLOYMENT=your_convex_deployment_reference_here
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-instance.clerk.accounts.dev

# AI Grading Providers (Set in Convex via `npx convex env set` or in .env.local)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Email (Resend) — set in Convex via `npx convex env set`
RESEND_API_KEY=your_resend_api_key_here
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret_here
